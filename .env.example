PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=

JWT_SECRET=
JWT_EXPIRES_IN=7d

APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# البريد الصادر — حساب Gmail مع "كلمة مرور التطبيقات" (App Password)
# يُولَّد من: Google Account ← Security ← App passwords
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# صلاحية رمز التحقّق بالدقائق
OTP_TTL_MINUTES=10

# حساب المشرف الأول — يقرأه سكربت seed:admin
# لا قيمة افتراضية: السكربت يرفض العمل إن كانت فارغة (8 محارف على الأقل)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# مزامنة بنية القاعدة تلقائياً من الكيانات.
# اتركها فارغة محلياً (تعمل تلقائياً في التطوير).
# في الإنتاج: true لأول نشر فقط لإنشاء الجداول، ثم أعدها false.
DB_SYNCHRONIZE=
